# ===========================================
# Pushboy Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Keep real APNS/FCM credentials outside git.

# Server
SERVER_PORT=:8080

# ===========================================
# Worker Pool Configuration
# ===========================================
# Tune these for your throughput requirements.
# Sends are synchronous, so SENDER_COUNT caps in-flight provider requests:
# SENDER_COUNT / provider latency is an upper bound; provider throttling and
# outcome persistence can lower sustained throughput.

# Number of master (fanout) goroutines (default: 10)
WORKER_COUNT=10

# Number of sender goroutines (default: 2000)
SENDER_COUNT=2000

# Size of the job queue buffer (default: 1000)
JOB_QUEUE_SIZE=1000

# Size of the task queue between fanout and senders (default: 10000)
TASK_QUEUE_SIZE=10000

# Size of the outcome queue between senders and the outcome writer (default: 50000)
DLQ_QUEUE_SIZE=50000

# Number of tokens to fetch per batch from DB (default: 5000)
# Higher values reduce DB round trips but use more memory
BATCH_SIZE=5000

# Outcomes per DB flush and max seconds between flushes (defaults: 1000, 10)
OUTCOME_BATCH_SIZE=1000
OUTCOME_FLUSH_SECONDS=10

# Max time to drain in-memory work during shutdown (default: 120 seconds)
SHUTDOWN_TIMEOUT_SECONDS=120

# Live Activity lane — separate worker pool so LA updates never queue
# behind large push notification fanouts

# Number of LA master goroutines (default: 5)
LA_WORKER_COUNT=5

# Number of LA sender goroutines (default: 300)
LA_SENDER_COUNT=300

# Separate LA buffers keep provider sends and outcome persistence from
# backpressuring each other. The task buffer stays at one DB batch so stale
# updates cannot build an unbounded backlog.
LA_JOB_QUEUE_SIZE=1000
LA_TASK_QUEUE_SIZE=5000
LA_DLQ_QUEUE_SIZE=50000

# Deprecated compatibility setting. When present, LA_QUEUE_SIZE supplies the
# default for all three LA queue sizes unless a specific value above is set.
# LA_QUEUE_SIZE=1000

# Number of retries available to notification outcome retry paths
MAX_RETRY_NOTIFICATION=3

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL connection string. The app runs migrations from db/migrations/postgres on startup.
DATABASE_URL=postgres://user:password@localhost:5432/pushboy?sslmode=disable

# ===========================================
# Apple Push Notification Service (APNS)
# ===========================================
# Get these from Apple Developer Console

# Key ID from your .p8 file (e.g., 52Q5U5B8JV)
APNS_KEY_ID=

# Team ID from Apple Developer account
APNS_TEAM_ID=

# Bundle ID of your iOS app (e.g., com.example.app).
# APNS_TOPIC_ID is still accepted as a fallback, but APNS_BUNDLE_ID is preferred.
APNS_BUNDLE_ID=
APNS_TOPIC_ID=

# Path to APNS .p8 key inside the runtime environment
APNS_KEY_PATH=keys/AuthKey_YOUR_KEY_ID.p8

# true for sandbox APNS, false for production APNS
APNS_USE_SANDBOX=false

# HTTP clients in the APNs pool; each owns its own HTTP/2 connection(s),
# ~1000 concurrent streams per connection (default: 8)
APNS_CLIENT_POOL=8

# Cap on in-flight APNs requests. 0 derives APNS_CLIENT_POOL * 900 (default: 0)
APNS_MAX_CONCURRENT=0

# ===========================================
# Firebase Cloud Messaging (FCM)
# ===========================================
# Get these from Firebase Console

# Path to service account JSON. project_id is read from this file.
FCM_KEY_PATH=keys/service-account.json

# ===========================================
# Broadcast Topic
# ===========================================
# Users created by the API are automatically subscribed to this topic.
BROADCAST_TOPIC_NAME=broadcast
