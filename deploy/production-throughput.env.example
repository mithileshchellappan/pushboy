# Non-secret throughput overrides validated on the production Pushboy VM.
# Merge these values into the deployment's existing .env; do not replace
# DATABASE_URL, APNS credentials, or FCM credentials with this file.

WORKER_COUNT=4
SENDER_COUNT=1000
JOB_QUEUE_SIZE=75000
TASK_QUEUE_SIZE=10000
DLQ_QUEUE_SIZE=50000
BATCH_SIZE=5000

LA_WORKER_COUNT=5
LA_SENDER_COUNT=3000
LA_JOB_QUEUE_SIZE=1000
LA_TASK_QUEUE_SIZE=20000
LA_DLQ_QUEUE_SIZE=200000

OUTCOME_BATCH_SIZE=5000
OUTCOME_FLUSH_SECONDS=1
SHUTDOWN_TIMEOUT_SECONDS=120

# Each lane owns its own transports. Zero derives a per-lane cap of 900
# in-flight requests per configured client.
APNS_CLIENT_POOL=24
APNS_MAX_CONCURRENT=0
LA_APNS_CLIENT_POOL=24
LA_APNS_MAX_CONCURRENT=0

# Push and Live Activity FCM lanes are independently bounded.
FCM_CLIENT_POOL=4
FCM_MAX_CONCURRENT=360
LA_FCM_CLIENT_POOL=4
LA_FCM_MAX_CONCURRENT=360

# One provider retry after the initial send attempt.
MAX_RETRY_NOTIFICATION=1
